# --- environment: never committed, rebuilt from env-lock-candidate.txt -------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- pinned third-party source ------------------------------------------------------
# gym-pybullet-drones is an editable clone pinned by SHA in env-lock-candidate.txt
# (learnsyslab/gym-pybullet-drones @ 7ebad1e). It is NOT vendored and NOT a submodule
# -- see docs/phase0_env.md "Repo layout decisions" for why.
third_party/

# --- measurement output -------------------------------------------------------------
# Small Phase 0 artifacts (plots, step-response CSVs, the contact sheet) ARE committed:
# they are the evidence behind docs/phase0_env.md. Bulk recordings are not -- the
# profiler regenerates them with one command.
results/gui_run/
results/env_profile*/
results/**/frames/
*.npy
results/playground/
results/try_env/
results/inspect/

# --- private, never published -------------------------------------------------------
# personal planning constraints; removed from history before the first push
robotics_project/CONSTRAINTS.md

# --- datasets -------------------------------------------------------------------------
# Images and parquet files are regenerated by `python -m dronevla.record`; only the small
# provenance files are tracked, so the manifest's SHA256s can be checked against a rebuild.
data/*/*
!data/*/manifest.json
!data/*/datasheet.md
!data/*/splits.json
!data/*/validation.json
